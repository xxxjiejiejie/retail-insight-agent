APP_NAME=Retail Insight Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# 第一阶段使用占位配置；不要把真实密钥提交到 Git。
LLM_PROVIDER=deepseek_anthropic
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=

DATABASE_URL=mysql+aiomysql://retail_readonly:readonly-local-dev@localhost:3307/retail_insight
SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/runtime/sessions.db
LANGGRAPH_STRICT_MSGPACK=true

VECTOR_STORE=chroma
VECTOR_STORE_PATH=./data/vector_store
MODEL_CACHE_PATH=./data/runtime/model_cache
HOST_MODEL_CACHE_PATH=./data/runtime/model_cache
MODEL_LOCAL_FILES_ONLY=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RETRIEVAL_TOP_K=12
RAG_RERANK_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.1

MAX_SQL_RETRIES=2
MAX_RESULT_ROWS=500
SQL_QUERY_TIMEOUT_SECONDS=15
DATA_AS_OF_DATE=2026-06-30
