APP_NAME=Retail Insight Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# 第一阶段使用占位配置；不要把真实密钥提交到 Git。
LLM_PROVIDER=deepseek_anthropic
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=

# LangSmith 可观测性默认关闭；启用后仅发送脱敏和截断后的追踪数据。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retail-insight-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_MAX_STRING_LENGTH=2000
LANGSMITH_POLICY_EXCERPT_LENGTH=600

# 扫描版 PDF 的可选 OCR 回退。仅当 pypdf 提取不到任何原生文本时才会调用；
# 请勿提交真实密钥，也请仅在确认可外发的文档上启用。
OCR_ENABLED=false
OCR_PROVIDER=qwen_openai_compatible
OCR_MODEL=qwen3.7-plus
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=
OCR_MAX_PAGES=20
OCR_MAX_TOKENS=2000
OCR_TIMEOUT_SECONDS=60

DATABASE_URL=mysql+aiomysql://retail_readonly:readonly-local-dev@localhost:3307/retail_insight
SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/runtime/sessions.db
LANGGRAPH_STRICT_MSGPACK=true

VECTOR_STORE=chroma
VECTOR_STORE_PATH=./data/vector_store
MODEL_CACHE_PATH=./data/runtime/model_cache
HOST_MODEL_CACHE_PATH=./data/runtime/model_cache
MODEL_LOCAL_FILES_ONLY=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RETRIEVAL_TOP_K=12
RAG_VECTOR_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.1
LEXICAL_CORPUS_PATH=./data/runtime/bm25_corpus.json

MAX_SQL_RETRIES=2
MAX_RESULT_ROWS=500
SQL_QUERY_TIMEOUT_SECONDS=15
DATA_AS_OF_DATE=2026-06-30
