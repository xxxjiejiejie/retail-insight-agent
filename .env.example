APP_NAME=Retail Insight Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# 第一阶段使用占位配置；不要把真实密钥提交到 Git。
LLM_PROVIDER=openai_compatible
LLM_MODEL=your-model-name
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=

DATABASE_URL=mysql+aiomysql://retail:retail@localhost:3306/retail_insight
SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/runtime/sessions.db

VECTOR_STORE=chroma
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base

MAX_SQL_RETRIES=2
MAX_RESULT_ROWS=500
SQL_QUERY_TIMEOUT_SECONDS=15

